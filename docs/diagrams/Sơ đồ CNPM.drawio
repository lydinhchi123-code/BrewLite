<mxfile host="app.diagrams.net" pages="3">
  <diagram name="Activity Diagram" id="f5gC875eMYNDzn21hVj4">
    <mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Activity Diagram - Quy trình đặt hàng và thanh toán BrewLite\n\n|Khách hàng|\nstart\n:Chọn sản phẩm;\n:Tùy chỉnh size, lượng đường,\\nlượng đá và topping;\n:Thêm sản phẩm vào giỏ hàng;\n:Truy cập trang thanh toán;\n\n|Giao diện Next.js|\n:Đọc thông tin giỏ hàng và checkout;\n:Kiểm tra thông tin đăng nhập;\n\nif (Có access token?) then (Có)\n  :Hiển thị biểu mẫu thanh toán;\nelse (Không)\n  :Thông báo yêu cầu đăng nhập;\n  stop\nendif\n\n|Khách hàng|\n:Nhập họ tên, số điện thoại,\\nđịa chỉ, phường và ghi chú;\n:Chọn mã giảm giá (nếu có);\n:Chọn phương thức thanh toán;\n\n|Giao diện Next.js|\n:Kiểm tra thông tin đã nhập;\n\nif (Thông tin hợp lệ?) then (Có)\n  :Gửi yêu cầu POST /orders\\nkèm Bearer token;\nelse (Không)\n  :Hiển thị thông báo lỗi nhập liệu;\n  stop\nendif\n\n|Backend NestJS|\n:Xác thực access token;\n\nif (Token hợp lệ?) then (Có)\n  :Tiếp nhận yêu cầu tạo đơn hàng;\n  :Xử lý thông tin đơn hàng;\nelse (Không)\n  :Trả về lỗi xác thực;\n  |Giao diện Next.js|\n  :Hiển thị lỗi tạo đơn hàng;\n  stop\nendif\n\nif (Tạo đơn hàng thành công?) then (Có)\n  :Trả về mã đơn hàng hiển thị\\nvà mã đơn hàng nội bộ;\nelse (Không)\n  :Trả về lỗi tạo đơn hàng;\n  |Giao diện Next.js|\n  :Hiển thị thông báo lỗi;\n  stop\nendif\n\n|Giao diện Next.js|\n:Lưu thông tin đơn hàng;\n:Chuyển sang bước thanh toán;\n\n|Khách hàng|\n:Xác nhận thanh toán;\n\n|Giao diện Next.js|\n:Tạo hoặc lấy Idempotency-Key;\n:Gửi yêu cầu POST /payments\\nkèm mã đơn hàng và phương thức thanh toán;\n\n|Backend NestJS|\n:Xác thực yêu cầu thanh toán;\n:Xử lý thanh toán theo phương thức đã chọn;\n\nif (Phương thức COD?) then (Có)\n  :Ghi nhận phương thức thanh toán COD;\nelse (Không)\n  if (Kết quả thanh toán mô phỏng thành công?) then (Có)\n    :Ghi nhận thanh toán thành công;\n  else (Không)\n    :Ghi nhận thanh toán thất bại;\n  endif\nendif\n\nif (Thanh toán thất bại?) then (Có)\n  :Trả về paymentStatus = THAT_BAI;\n  |Giao diện Next.js|\n  :Hiển thị thông báo thanh toán thất bại;\n  :Cho phép khách hàng thử thanh toán lại;\n  stop\nelse (Không)\n  :Trả về kết quả thanh toán;\nendif\n\n|Giao diện Next.js|\n:Xóa giỏ hàng;\n:Chuyển đến trang xác nhận đơn hàng;\n:Gửi yêu cầu GET /orders/:orderId;\n\n|Backend NestJS|\n:Xác thực token và quyền truy cập;\n:Truy vấn thông tin đơn hàng;\n\nif (Tìm thấy đơn hàng?) then (Có)\n  :Trả về chi tiết đơn hàng\\nvà trạng thái thanh toán;\nelse (Không)\n  :Trả về lỗi không tìm thấy đơn hàng;\n  |Giao diện Next.js|\n  :Hiển thị thông báo lỗi;\n  stop\nendif\n\n|Giao diện Next.js|\n:Hiển thị mã đơn hàng,\\nthông tin sản phẩm, tổng tiền\\nvà trạng thái thanh toán;\nstop\n@enduml\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="SSfcAxcAIWn69eRanGyG-133">
