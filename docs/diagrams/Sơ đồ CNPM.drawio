  <diagram id="6ZZ4S2H2L8jguRZbHM_u" name="Class Diagram">
    <mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle CLASS DIAGRAM - MÔ HÌNH LỚP HỆ THỐNG BREWLITE\n\nleft to right direction\n\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nskinparam linetype ortho\nskinparam packageStyle rectangle\nskinparam nodesep 45\nskinparam ranksep 55\n\nskinparam class {\n    BackgroundColor White\n    BorderColor #555555\n    ArrowColor #555555\n}\nskinparam enum {\n    BackgroundColor #FCE4D6\n    BorderColor #C66A45\n}\n\n&#39; =====================================================\n&#39; 1. KHÁCH HÀNG VÀ QUẢN TRỊ VIÊN\n&#39; =====================================================\n\npackage \&quot;NGƯỜI DÙNG\&quot; {\n\n    class KhachHang {\n        - makh: int\n        - hoten: string\n        - email: string\n        - sodienthoai: string\n    }\n\n    class Admin {\n        - vaiTro: string\n        + dangNhap(): boolean\n        + xemTongQuan(): void\n        + quanLyDonHang(): void\n        + quanLyTonKho(): void\n        + quanLyCongThuc(): void\n        + quanLyMaGiamGia(): void\n    }\n}\n\nnote right of Admin\n    Đại diện cho vai trò quản trị.\n    Giao diện hiện có đăng nhập\n    bằng mật khẩu và sessionStorage.\n    Chưa xác nhận có bảng Admin\n    riêng trong PostgreSQL.\nend note\n\n&#39; =====================================================\n&#39; 2. DANH MỤC, SẢN PHẨM VÀ TOPPING\n&#39; =====================================================\n\npackage \&quot;QUẢN LÝ MENU\&quot; {\n\n    class DanhMuc {\n        - id: int\n        - tenDanhMuc: string\n        - slug: string\n    }\n\n    class SanPham {\n        - id: int\n        - categoryId: int\n        - ten: string\n        - slug: string\n        - moTa: string\n        - giaCoBan: number\n        - hinhAnh: string\n        - noiBat: boolean\n        - khaDung: boolean\n        - thuTuHienThi: int\n    }\n\n    class Topping {\n        - id: int\n        - ten: string\n        - gia: number\n        - khaDung: boolean\n    }\n\n    class SanPhamTopping {\n        - sanPhamId: int\n        - toppingId: int\n    }\n}\n\nDanhMuc \&quot;1\&quot; -- \&quot;0..*\&quot; SanPham : phân loại\n\nSanPham \&quot;1\&quot; -- \&quot;0..*\&quot; SanPhamTopping\nTopping \&quot;1\&quot; -- \&quot;0..*\&quot; SanPhamTopping\n\nnote bottom of SanPhamTopping\n    Lớp liên kết biểu diễn topping\n    được phép sử dụng cho sản phẩm.\nend note\n\n&#39; =====================================================\n&#39; 3. GIỎ HÀNG\n&#39; =====================================================\n\npackage \&quot;GIỎ HÀNG\&quot; {\n\n    class GioHang {\n        - items: CartItem[]\n        - subtotal: number\n        + themSanPham(): void\n        + capNhatSoLuong(): void\n        + xoaSanPham(): void\n        + tinhTongTien(): number\n    }\n\n    class CartItem {\n        - id: string\n        - name: string\n        - image: string\n        - price: number\n        - quantity: number\n        - size: string\n        - sugar: string\n        - ice: string\n        - topping: string[]\n    }\n}\n\nKhachHang \&quot;1\&quot; -- \&quot;0..1\&quot; GioHang : sở hữu\nGioHang \&quot;1\&quot; *-- \&quot;0..*\&quot; CartItem : chứa\nCartItem \&quot;*\&quot; --&gt; \&quot;1\&quot; SanPham : tham chiếu\n\n&#39; =====================================================\n&#39; 4. ĐƠN HÀNG\n&#39; =====================================================\n\npackage \&quot;QUẢN LÝ ĐƠN HÀNG\&quot; {\n\n    class DonHang {\n        - madonhang: int\n        - orderId: string\n        - makh: int\n        - createdAt: datetime\n        - orderStatus: string\n        - subtotal: number\n        - deliveryFee: number\n        - discount: number\n        - totalAmount: number\n        - note: string\n        + taoDonHang(): void\n        + capNhatTrangThai(): void\n        + tinhTongTien(): number\n    }\n\n    class ChiTietDonHang {\n        - name: string\n        - size: string\n        - options: string\n        - quantity: int\n        - price: number\n        - lineTotal: number\n    }\n}\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonHang : đặt\n\nDonHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDonHang : bao gồm\n\nChiTietDonHang \&quot;*\&quot; --&gt; \&quot;1\&quot; SanPham : sản phẩm\n\nnote right of DonHang\n    orderId: Mã đơn hàng hiển thị\n    madonhang: Mã đơn hàng nội bộ\n\n    ChiTietDonHang lưu thông tin\n    sản phẩm tại thời điểm đặt hàng.\nend note\n\n&#39; =====================================================\n&#39; 5. MÃ GIẢM GIÁ\n&#39; =====================================================\n\npackage \&quot;KHUYẾN MÃI\&quot; {\n\n    class MaGiamGia {\n        - id: int\n        - ma: string\n        - ten: string\n        - loai_ma: string\n        - so_tien_giam: number\n        - don_hang_toi_thieu: number\n        - so_luong_toi_da: int\n        - so_luong_da_dung: int\n        - ngay_bat_dau: datetime\n        - ngay_ket_thuc: datetime\n        - trang_thai: string\n    }\n}\n\nMaGiamGia \&quot;0..1\&quot; -- \&quot;0..*\&quot; DonHang : áp dụng\n\n&#39; =====================================================\n&#39; 6. THANH TOÁN\n&#39; =====================================================\n\npackage \&quot;THANH TOÁN\&quot; {\n\n    class ThanhToan {\n        - madonhang: int\n        - phuongthuc: PaymentMethod\n        - paymentStatus: string\n        - idempotencyKey: string\n        + xuLyThanhToan(): boolean\n        + kiemTraTrangThai(): string\n    }\n\n    enum PaymentMethod {\n        COD\n        BANKING\n        MOMO\n    }\n}\n\nDonHang \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToan : thanh toán\nThanhToan --&gt; PaymentMethod : sử dụng\n\nnote right of ThanhToan\n    Idempotency-Key được gửi\n    trong header của POST /payments.\n\n    Banking và MoMo hiện sử dụng\n    kết quả thanh toán mô phỏng.\nend note\n\n&#39; =====================================================\n&#39; 7. QUẢN LÝ KHO NGUYÊN LIỆU\n&#39; =====================================================\n\npackage \&quot;QUẢN LÝ KHO\&quot; {\n\n    class NguyenLieu {\n        - id: int\n        - tenNguyenLieu: string\n        - donViTinh: string\n        - giaNhap: number\n    }\n\n    class TonKho {\n        - id: int\n        - nguyenLieuId: int\n        - soLuongTon: number\n        - mucCanhBao: number\n        - ngayCapNhat: datetime\n        + capNhatTonKho(): void\n        + kiemTraTonKho(): boolean\n    }\n}\n\nNguyenLieu \&quot;1\&quot; -- \&quot;1\&quot; TonKho : có số lượng tồn\n\n&#39; =====================================================\n&#39; 8. CÔNG THỨC PHA CHẾ\n&#39; =====================================================\n\npackage \&quot;CÔNG THỨC PHA CHẾ\&quot; {\n\n    class CongThuc {\n        - id: int\n        - sanPhamId: int\n        - tenCongThuc: string\n        - moTa: string\n    }\n\n    class ChiTietCongThuc {\n        - id: int\n        - congThucId: int\n        - nguyenLieuId: int\n        - dinhLuong: number\n        - donViTinh: string\n    }\n}\n\nSanPham \&quot;1\&quot; -- \&quot;0..*\&quot; CongThuc : có công thức\n\nCongThuc \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietCongThuc : bao gồm\n\nChiTietCongThuc \&quot;*\&quot; --&gt; \&quot;1\&quot; NguyenLieu : sử dụng\n\n&#39; =====================================================\n&#39; 9. QUAN HỆ QUẢN TRỊ\n&#39; =====================================================\n\nAdmin ..&gt; DonHang : quản lý\nAdmin ..&gt; MaGiamGia : quản lý\nAdmin ..&gt; TonKho : theo dõi\nAdmin ..&gt; CongThuc : quản lý\nAdmin ..&gt; SanPham : quản lý\nAdmin ..&gt; DanhMuc : quản lý\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="P0bJifOYOBJWQ20NNkXE-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
